<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SplashTheme" parent="GadgetbridgeTheme.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/heartbeat_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@color/heartbeat_background</item>
        <item name="android:navigationBarColor">@color/heartbeat_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
