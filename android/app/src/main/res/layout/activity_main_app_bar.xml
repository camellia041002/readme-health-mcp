<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".activities.ControlCenterv2">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/heartbeat_panel"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/heartbeat_panel" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/dashboard_swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appbarlayout"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/dashboard_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="@color/heartbeat_background"
        app:itemBackground="@android:color/transparent"
        app:itemIconTint="@color/readme_bottom_nav_tint"
        app:itemTextColor="@color/readme_bottom_nav_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <FrameLayout
        android:id="@+id/heartbeat_splash_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/heartbeat_background"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/heartbeat_splash_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0"
                android:background="@drawable/readme_pulse_dot" />

            <TextView
                android:id="@+id/heartbeat_splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0"
                android:text="@string/app_name"
                android:textColor="@color/heartbeat_charcoal"
                android:fontFamily="sans-serif-medium"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/heartbeat_splash_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0"
                android:text="@string/heartbeat_tagline"
                android:textColor="@color/secondarytext"
                android:textSize="14sp" />

            <nodomain.freeyourgadget.gadgetbridge.widget.ReadMeSplashWaveView
                android:id="@+id/heartbeat_splash_wave"
                android:layout_width="160dp"
                android:layout_height="72dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
