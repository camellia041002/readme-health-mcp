# Copy to keystore.properties and fill in real values. This file is ignored by Git.
# Create a dedicated public-release key outside the repository. Keep the same public key
# for future ReadMe public upgrades, but never reuse a private-build or upstream key.
storeFile=/absolute/path/to/readme-release.jks
storePassword=your-store-password
keyAlias=readme-release
keyPassword=your-key-password
