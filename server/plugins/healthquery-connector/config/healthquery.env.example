# Point this at the deployed HealthQuery Streamable HTTP endpoint, including /mcp.
# Do not commit a real URL if it contains private routing details.
HEALTHQUERY_MCP_URL=https://health.example.com/mcp

# Only required when using config/healthquery-bearer.mcp.json.
# Store the credential in a secret manager or process environment; never commit it.
HEALTHQUERY_MCP_BEARER_TOKEN=
