# HealthQuery production container environment template.
# Copy this file to .env, replace the example public hostname, then run
# scripts/generate-secrets.sh before `docker compose up -d --build`.

HEALTHQUERY_ENV=production
HEALTHQUERY_PUBLIC_URL=https://health.example.com
HEALTHQUERY_ALLOWED_HOSTS=health.example.com
HEALTHQUERY_CORS_ORIGINS=https://health.example.com
HEALTHQUERY_MCP_ALLOWED_ORIGINS=https://health.example.com
HEALTHQUERY_MCP_ISSUER_URL=https://health.example.com/mcp
HEALTHQUERY_MCP_RESOURCE_URL=https://health.example.com/mcp
# The reverse proxy normally reaches the published loopback port. If it runs
# in another container/network, add only that proxy's fixed IP/CIDR here.
HEALTHQUERY_TRUSTED_PROXY_IPS=127.0.0.1,::1
HEALTHQUERY_PORT=3135
HEALTHQUERY_IMAGE=healthquery:local
HEALTHQUERY_DATA_VOLUME=healthquery-data

DB_PATH=/app/data/healthquery.db
HEALTHQUERY_AUTH_HEADER=X-Webhook-Token
HEALTHQUERY_LOG_LEVEL=INFO
HEALTHQUERY_RETENTION_DAYS=365

# Optional REST-backed MCP server
HEALTHQUERY_BASE_URL=http://localhost:3135
